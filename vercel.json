{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/term",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/category",
      "destination": "/",
      "permanent": false
    }
  ]
}
